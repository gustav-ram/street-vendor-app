# Copy to .env (cp .env.example .env). Every value here is a local-dev default;
# no paid services or API keys are needed.

# ---------- API ----------
API_HOST=127.0.0.1
API_PORT=4000
# Public base URL of the API (used to build photo URLs). For a physical phone on
# your Wi-Fi, use your Mac's LAN IP and set API_HOST=0.0.0.0.
API_PUBLIC_URL=http://localhost:4000
DATABASE_URL=postgres://streeteats:streeteats@localhost:5432/streeteats
TEST_DATABASE_URL=postgres://streeteats:streeteats@localhost:5432/streeteats_test
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3100
WEB_BASE_URL=http://localhost:3100

# Secrets. Dev-only placeholders: replace with long random strings
# (openssl rand -base64 48) anywhere that isn't your laptop.
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
LOCATION_FUZZ_SECRET=dev-only-fuzz-secret-change-me-0123456789abcdef

ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# Live sessions (heartbeat + TTL). A vendor stays on the map only while the
# app keeps sending heartbeats; the stored location is deleted on expiry.
LIVE_HEARTBEAT_INTERVAL_SEC=60
LIVE_GRACE_SEC=300
LIVE_MAX_HOURS=16
# Local time when the "street day" ends and every live session closes.
STREET_DAY_ENDS_AT=03:00
DEFAULT_TIMEZONE=America/Los_Angeles

# "Approximate area" grid cell size in meters (shown point is within ~150 m).
APPROX_CELL_METERS=180

# Uploaded photos (local disk storage driver). Every photo is re-encoded,
# which drops EXIF/GPS and all other metadata.
UPLOAD_DIR=./data/uploads
# Larger images are refused (guards against "decompression bombs").
PHOTO_MAX_PIXELS=40000000

# "Still here?" confirmations (anti-gaming rules, see PLAN.md §6.6).
STILL_HERE_MIN_ACCOUNT_AGE_HOURS=24
STILL_HERE_RADIUS_APPROX_M=400
STILL_HERE_RADIUS_EXACT_M=200
STILL_HERE_DAILY_LIMIT=10

# "Community Verified" badge criteria (PLAN.md §6.6). Shown to vendors in the app.
BADGE_MIN_LIVE_DAYS=10
BADGE_MIN_CONFIRMATIONS=5
BADGE_MIN_CONFIRMATION_ACCOUNTS=3
BADGE_MIN_CONFIRMATION_DAYS=3
BADGE_CONFIRMATION_WINDOW_DAYS=30
BADGE_MIN_REVIEWS=3
BADGE_MIN_REVIEW_AVERAGE=3.5
BADGE_REPORT_WINDOW_DAYS=90

INVITE_REQUIRED=false
REVIEW_PREMODERATION=false

# ---------- Web (Next.js) ----------
NEXT_PUBLIC_API_URL=http://localhost:4000
# Where the join page's "Open in the app" button points (invite flyers). A dev or
# store build of the iPhone app opens streeteats:// links. While testing in Expo Go,
# use the Metro address instead, e.g. exp://127.0.0.1:8090/--/
NEXT_PUBLIC_APP_LINK=streeteats://

# ---------- Mobile (Expo) ----------
# The iOS Simulator shares your Mac's network, so localhost works there.
EXPO_PUBLIC_API_URL=http://localhost:4000
